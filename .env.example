# ============================================
# Network Config Tool - Environment Variables
# ============================================
# Version: V2608172
# Purpose: Configuration for deployment

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=24h

# User Credentials (for Railway deployment, use environment secrets)
# Format: USERNAME:PASSWORD|USERNAME:PASSWORD (pipe-separated)
# Example: admin:admin123|user:user123
VALID_USERS=admin:changeme

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./backend/uploads

# Logging
LOG_LEVEL=info
ENABLE_FILE_LOGGING=false

# CORS Configuration
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000

# Security
ENABLE_HELMET=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional: OAuth2 (for future)
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
